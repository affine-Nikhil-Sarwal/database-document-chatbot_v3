# Azure OpenAI (primary chat + embeddings)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview
# Legacy aliases (reuse agents also read these)
AZURE_OPENAI_API_BASE=
GPT4_LLM_MODEL_DEPLOYMENT_NAME=
EMBEDDING_MODEL_DEPLOYMENT_NAME=text-embedding-3-small

# Azure AI Search (document retrieval via Eryl)
AZURE_SEARCH_SERVICE_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=dupont_email_demo
AZURE_SEARCH_SEMANTIC_CONFIG_NAME=my-semantic-config
AZURE_SEARCH_VECTOR_FIELD_NAME=content_vector
AZURE_SEARCH_DOCUMENT_ID_FIELD_NAME=id

# SQL database (Quin) — set DATABASE_URL or discrete SQL_* vars
DATABASE_URL=
SQL_SERVER=
SQL_DATABASE=
SQL_USERNAME=
SQL_PASSWORD=
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_SCHEMA=dbo
